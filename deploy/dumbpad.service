[Unit]
Description=DumbPad notes server
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/workspace/DumbPad
EnvironmentFile=/workspace/DumbPad/.env
ExecStart=/usr/local/bin/node /workspace/DumbPad/server.js
Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
